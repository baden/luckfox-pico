# Add all source files to the list
SRCS = ssd1306_demo.c lv_port_ssd1306.c $(LVGL_SRCS)
OBJS = $(SRCS:.c=.o)
TARGET = ssd1306_demo

# Check if LVGL source exists
LVGL_EXISTS = $(shell test -f $(LVGL_SRCDIR)/core/lv_obj.c && echo yes || echo no)

all: check_lvgl $(TARGET)

check_lvgl:
	@if [ "$(LVGL_EXISTS)" != "yes" ]; then \
		echo "Error: LVGL source not found at $(LVGL_SRCDIR)/lvgl.c"; \
		echo "Please check that LVGL library is available"; \
		exit 1; \
	fi

$(TARGET): $(OBJS)
	$(CC) $(OBJS) -o $@ $(LDFLAGS)
	@echo "Successfully built $(TARGET)"
	@echo "Run with: ./$(TARGET)"

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGET)

.PHONY: all clean check_lvgl