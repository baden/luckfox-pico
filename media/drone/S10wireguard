#!/bin/sh

# WireGuard VPN Service Script
# File should be S10wireguard to start before network services

WG_SETUP_SCRIPT="/usr/bin/wireguard-setup.sh"
WG_CONFIG="/etc/wireguard/wg0.conf"
WG_DELAY_FILE="/etc/wireguard/startup_delay"

# Function to check if wireguard tools are available
check_dependencies() {
    # Check for required commands
    if ! command -v wg >/dev/null 2>&1; then
        echo "Error: wg command not found. WireGuard tools may not be installed."
        return 1
    fi
    
    if ! command -v ip >/dev/null 2>&1; then
        echo "Error: ip command not found."
        return 1
    fi
    
    return 0
}

# Function to wait for network
wait_for_network() {
    echo "Waiting for network to be ready..."
    
    # Wait up to 30 seconds for network
    local count=0
    while [ $count -lt 30 ]; do
        # Check if we have network connectivity (try to ping gateway)
        if ip route | grep -q "default"; then
            GATEWAY=$(ip route | grep default | awk '{print $3}')
            if [ -n "$GATEWAY" ] && ping -c 1 -W 2 $GATEWAY >/dev/null 2>&1; then
                echo "Network is ready"
                return 0
            fi
        fi
        
        # Also check if network interfaces are up
        if ip link show | grep -q "state UP"; then
            echo "Network interface detected"
            return 0
        fi
        
        sleep 1
        count=$((count + 1))
    done
    
    echo "Warning: Network may not be fully ready, proceeding anyway"
    return 0
}

# Function to read startup delay
get_startup_delay() {
    if [ -f "$WG_DELAY_FILE" ]; then
        DELAY=$(cat $WG_DELAY_FILE 2>/dev/null || echo "5")
    else
        DELAY=5
    fi
    
    # Ensure delay is reasonable
    if [ "$DELAY" -lt 0 ] || [ "$DELAY" -gt 60 ]; then
        DELAY=5
    fi
    
    echo $DELAY
}

start() {
    echo "Starting WireGuard VPN service..."
    
    # Check dependencies
    if ! check_dependencies; then
        echo "Failed: Missing dependencies"
        return 1
    fi
    
    # Check if configuration exists
    if [ ! -f "$WG_CONFIG" ]; then
        echo "Error: WireGuard config not found: $WG_CONFIG"
        echo "Please run /usr/bin/generate-wg-keys.sh to create configuration"
        return 1
    fi
    
    # Wait for network to be ready
    wait_for_network
    
    # Get startup delay
    DELAY=$(get_startup_delay)
    if [ "$DELAY" -gt 0 ]; then
        echo "Waiting $DELAY seconds before starting VPN..."
        sleep $DELAY
    fi
    
    # Start WireGuard using the setup script
    if [ -x "$WG_SETUP_SCRIPT" ]; then
        echo "Executing WireGuard setup script..."
        $WG_SETUP_SCRIPT start
        if [ $? -eq 0 ]; then
            echo "WireGuard VPN started successfully"
        else
            echo "Error: Failed to start WireGuard VPN"
            return 1
        fi
    else
        echo "Error: WireGuard setup script not found: $WG_SETUP_SCRIPT"
        return 1
    fi
    
    return 0
}

stop() {
    echo "Stopping WireGuard VPN service..."
    
    if [ -x "$WG_SETUP_SCRIPT" ]; then
        $WG_SETUP_SCRIPT stop
        echo "WireGuard VPN stopped"
    fi
    
    return 0
}

restart() {
    echo "Restarting WireGuard VPN service..."
    stop
    sleep 2
    start
}

status() {
    if [ -x "$WG_SETUP_SCRIPT" ]; then
        $WG_SETUP_SCRIPT status
    else
        echo "WireGuard setup script not available"
        return 1
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        echo ""
        echo "Configuration file: $WG_CONFIG"
        echo "Setup script: $WG_SETUP_SCRIPT"
        echo ""
        echo "To generate initial configuration:"
        echo "  /usr/bin/generate-wg-keys.sh"
        echo ""
        echo "To adjust startup delay:"
        echo "  echo '10' > $WG_DELAY_FILE"
        exit 1
        ;;
esac

exit $?