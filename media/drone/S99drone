#!/bin/sh

# Drone application startup script for BusyBox/SysV init
# File should be named S99drone to start last in boot sequence

DAEMON="/usr/bin/drone"
DAEMON_NAME="drone"
PIDFILE="/var/run/drone.pid"
LOGFILE="/var/log/drone.log"

start() {
    # Create necessary directories
    mkdir -p /var/run /var/log
    
    # Check if already running
    if [ -f $PIDFILE ]; then
        PID=$(cat $PIDFILE)
        if kill -0 $PID 2>/dev/null; then
            echo "$DAEMON_NAME is already running with PID $PID"
            return 1
        else
            # Stale PID file
            rm -f $PIDFILE
        fi
    fi
    
    echo -n "Starting $DAEMON_NAME: "
    
    # Start daemon in background with PID file
    $DAEMON >> $LOGFILE 2>&1 &
    PID=$!
    echo $PID > $PIDFILE
    
    # Verify it started successfully
    sleep 1
    if kill -0 $PID 2>/dev/null; then
        echo "done (PID: $PID)"
        return 0
    else
        echo "failed"
        rm -f $PIDFILE
        return 1
    fi
}

stop() {
    if [ ! -f $PIDFILE ]; then
        echo "$DAEMON_NAME is not running"
        return 1
    fi
    
    PID=$(cat $PIDFILE)
    echo -n "Stopping $DAEMON_NAME: "
    
    if kill -0 $PID 2>/dev/null; then
        kill $PID
        # Wait for process to stop
        count=0
        while kill -0 $PID 2>/dev/null && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
        done
        
        if kill -0 $PID 2>/dev/null; then
            # Force kill if still running
            kill -9 $PID
            sleep 1
        fi
        
        echo "done"
    else
        echo "not running"
    fi
    
    rm -f $PIDFILE
}

restart() {
    stop
    sleep 2
    start
}

status() {
    if [ -f $PIDFILE ]; then
        PID=$(cat $PIDFILE)
        if kill -0 $PID 2>/dev/null; then
            echo "$DAEMON_NAME is running with PID $PID"
            return 0
        else
            echo "$DAEMON_NAME is not running (stale PID file)"
            rm -f $PIDFILE
            return 1
        fi
    else
        echo "$DAEMON_NAME is not running"
        return 1
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit $?